{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "aulycMail",
  "build:dir": ".cache/wails",
  "outputfilename": "aulycMail",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "info": {
    "companyName": "aulyc",
    "productName": "aulycMail",
    "productVersion": "0.8.4",
    "copyright": "Copyright © 2026 aulyc",
    "comments": "A lightweight desktop e-mail client",
    "protocols": [
      {
        "scheme": "mailto",
        "description": "Email"
      }
    ]
  },
  "author": {
    "name": "aulyc",
    "email": "xaulyc@gmail.com"
  }
}
